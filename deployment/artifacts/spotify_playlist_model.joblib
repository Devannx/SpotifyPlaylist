import pandas as pd
import numpy as np
import joblib
import re

from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.neighbors import NearestNeighbors
from scipy.sparse import csr_matrix

# ==========================================
# 1. LOAD DATASET
# ==========================================

file_path = "spotify_dataset.csv"

df = pd.read_csv(file_path)

print("Dataset berhasil dimuat.")
print("Ukuran dataset:", df.shape)
print("Kolom dataset:", df.columns.tolist())

# ==========================================
# 2. DETEKSI KOLOM SECARA OTOMATIS
# ==========================================

def normalize_column(name):
    return re.sub(r"[^a-z0-9]", "", str(name).lower())

column_lookup = {
    normalize_column(column): column
    for column in df.columns
}

aliases = {
    "trackname": [
        "trackname",
        "track",
        "song",
        "songname",
        "tracktitle"
    ],
    "artistname": [
        "artistname",
        "artist",
        "artists",
        "artistnames"
    ],
    "playlistname": [
        "playlistname",
        "playlist",
        "playlisttitle"
    ]
}

selected_columns = {}

for feature, possible_names in aliases.items():
    for name in possible_names:
        normalized = normalize_column(name)

        if normalized in column_lookup:
            selected_columns[feature] = column_lookup[normalized]
            break

# ==========================================
# 3. VALIDASI KOLOM
# ==========================================

if "trackname" not in selected_columns:
    raise ValueError(
        "Kolom nama lagu tidak ditemukan. "
        "Periksa nama kolom pada dataset."
    )

print("Kolom yang digunakan:", selected_columns)

# ==========================================
# 4. DATA CLEANING
# ==========================================

for feature, column in selected_columns.items():
    df[column] = (
        df[column]
        .fillna("")
        .astype(str)
        .str.strip()
    )

track_column = selected_columns["trackname"]

# Hapus baris yang tidak memiliki nama lagu
df = df[df[track_column] != ""].copy()

# ==========================================
# 5. GABUNGKAN FITUR TEKS
# ==========================================

text_columns = list(selected_columns.values())

df["combined_features"] = (
    df[text_columns]
    .agg(" ".join, axis=1)
    .str.lower()
    .str.strip()
)

# Hapus baris yang fitur teksnya kosong
df = df[df["combined_features"] != ""].reset_index(drop=True)

if len(df) < 2:
    raise ValueError(
        "Data terlalu sedikit untuk membuat model rekomendasi."
    )

# ==========================================
# 6. TF-IDF VECTORIZATION
# ==========================================

vectorizer = TfidfVectorizer(
    stop_words=None,
    max_features=50000,
    ngram_range=(1, 2)
)

tfidf_matrix = vectorizer.fit_transform(
    df["combined_features"]
)

print("TF-IDF berhasil dibuat.")
print("Ukuran matriks:", tfidf_matrix.shape)

# ==========================================
# 7. TRAIN MODEL NEAREST NEIGHBORS
# ==========================================

n_neighbors = min(6, len(df))

model = NearestNeighbors(
    n_neighbors=n_neighbors,
    metric="cosine",
    algorithm="brute"
)

model.fit(tfidf_matrix)

# ==========================================
# 8. SIMPAN MODEL
# ==========================================

model_artifact = {
    "model": model,
    "vectorizer": vectorizer,
    "tfidf_matrix": tfidf_matrix,
    "tracks": df,
    "text_columns": text_columns,
    "selected_columns": selected_columns,
    "feature_column": "combined_features",
    "algorithm": "TF-IDF + Nearest Neighbors",
    "metric": "cosine"
}

joblib.dump(
    model_artifact,
    "spotify_playlist_model.joblib",
    compress=3
)

print("Model berhasil disimpan:")
print("spotify_playlist_model.joblib")
